# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE SECRETS (Edge Function only — never expose to client)
# Set these via: supabase secrets set KEY=value
# For local dev: add to supabase/.env (gitignored)
# ─────────────────────────────────────────────────────────────────

# Google Gemini AI
GOOGLE_AI_API_KEY=your_google_gemini_api_key

# Pinecone Vector Database
# Dashboard: https://app.pinecone.io → API Keys
# Used by: supabase/functions/generate-lesson (knowledge retrieval)
PINECONE_API_KEY=pc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_HOST=https://your-index-name-xxxx.svc.your-region.pinecone.io

# ── Social Media Manager (Sub-project #3) ────────────────────────
# Public OAuth client IDs/keys — safe to expose in browser bundle.
# Client SECRETS go in Supabase project secrets, never here.
VITE_META_APP_ID=
VITE_TIKTOK_CLIENT_KEY=
VITE_PINTEREST_APP_ID=

# ── Auto-Learn Edge Function ──────────────────────────────────────
# Used by: supabase/functions/auto-learn (same Google AI key as GOOGLE_AI_API_KEY above)
# Set separately so the two functions can use different keys if needed.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Research Edge Function ────────────────────────────────────────
# Used by: supabase/functions/research
SPARKS_EXA_API_KEY=your_exa_api_key_here
SPARKS_FIRECRAWL_API_KEY=your_firecrawl_api_key_here
